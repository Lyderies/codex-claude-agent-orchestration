{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning evidence review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "record_id", "subject_digests", "accepted", "observed_at_ms"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "evidence_review"},
    "record_id": {"type": "string", "pattern": "^evidence_review:[0-9a-f]{64}$"},
    "subject_digests": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "accepted": {"const": true},
    "observed_at_ms": {"type": "integer", "minimum": 0}
  }
}
