{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning canary report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "record_id", "candidate_digest", "champion_digest", "case_digests", "case_set_digest", "deterministic_pass", "security_pass", "required_criteria_pass", "quality_regressions", "passed", "comparison_digest", "case_outcomes", "observed_at_ms", "independent_review_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "canary_report"},
    "record_id": {"type": "string", "pattern": "^canary:[0-9a-f]{64}$"},
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "champion_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_digests": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "case_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deterministic_pass": {"type": "boolean"},
    "security_pass": {"type": "boolean"},
    "required_criteria_pass": {"type": "boolean"},
    "quality_regressions": {"type": "integer", "minimum": 0, "maximum": 10000},
    "passed": {"type": "boolean"},
    "comparison_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_outcomes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["case_digest", "champion_outcome_digest", "candidate_outcome_digest"], "properties": {"case_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "champion_outcome_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "candidate_outcome_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "observed_at_ms": {"type": "integer", "minimum": 0},
    "independent_review_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
