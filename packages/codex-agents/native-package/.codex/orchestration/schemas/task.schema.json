{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-agents.local/schemas/task.schema.json",
  "title": "Task request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "objective",
    "family",
    "complexity",
    "risk",
    "operation",
    "ambiguity",
    "context_breadth",
    "acceptance_strength",
    "routing_evidence_refs",
    "meaningful",
    "deterministic_validation",
    "independent_parts",
    "parallel_safe",
    "failed_attempts",
    "failure_events"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "family": {
      "enum": ["inventory", "research", "planning", "coding", "security", "verification"]
    },
    "complexity": {"enum": ["low", "medium", "high", "extreme"]},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "operation": {
      "enum": [
        "mechanical",
        "exploration",
        "implementation",
        "diagnosis",
        "synthesis",
        "review",
        "end_to_end"
      ]
    },
    "ambiguity": {"enum": ["known", "partial", "high", "unknown"]},
    "context_breadth": {
      "enum": ["narrow", "repository", "cross_system", "unknown"]
    },
    "acceptance_strength": {
      "enum": [
        "deterministic",
        "executable",
        "independent_judgment",
        "owner_decision"
      ]
    },
    "routing_evidence_refs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      }
    },
    "meaningful": {"type": "boolean"},
    "deterministic_validation": {"type": "boolean"},
    "independent_parts": {"type": "integer", "minimum": 1},
    "parallel_safe": {"type": "boolean"},
    "failed_attempts": {"type": "integer", "minimum": 0, "maximum": 2},
    "failure_events": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "reason", "evidence_refs"],
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "reason": {
            "enum": [
              "result_contract",
              "transient",
              "corrected_input",
              "semantic",
              "reasoning",
              "authority"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reason": {"enum": ["semantic", "reasoning"]}
              },
              "required": ["reason"]
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "items": {
                    "type": "string",
                    "pattern": "^verification:[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "owned_paths": {"type": "array", "items": {"type": "string"}},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "verification_for_family": {
      "enum": ["inventory", "research", "planning", "coding", "security"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"risk": {"enum": ["high", "critical"]}},
        "required": ["risk"]
      },
      "then": {"properties": {"meaningful": {"const": true}}}
    },
    {
      "if": {
        "properties": {"acceptance_strength": {"const": "deterministic"}},
        "required": ["acceptance_strength"]
      },
      "then": {"properties": {"deterministic_validation": {"const": true}}}
    },
    {
      "if": {"required": ["verification_for_family"]},
      "then": {"properties": {"family": {"const": "verification"}}}
    },
    {
      "if": {"properties": {"failed_attempts": {"const": 0}}},
      "then": {"properties": {"failure_events": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"failed_attempts": {"const": 1}}},
      "then": {
        "properties": {
          "failure_events": {
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "properties": {"attempt": {"const": 1}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"failed_attempts": {"const": 2}}},
      "then": {
        "properties": {
          "failure_events": {
            "minItems": 2,
            "maxItems": 4,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {"attempt": {"const": 1}}
                },
                "minContains": 1,
                "maxContains": 2
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {"attempt": {"const": 2}}
                },
                "minContains": 1,
                "maxContains": 2
              }
            ]
          }
        }
      }
    }
  ]
}
