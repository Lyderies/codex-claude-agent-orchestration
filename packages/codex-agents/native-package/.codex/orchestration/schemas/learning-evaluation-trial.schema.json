{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning evaluation trial v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "record_id", "case_id", "trial_id", "cohort", "task_slice", "configuration_digest", "coverage", "assigned", "status", "accepted", "deterministic_pass", "security_pass", "required_criteria_pass", "quality_micros", "terminal_failure", "repairs", "input_tokens", "output_tokens", "model_calls", "client_version", "client_digest", "outcome_digest", "evaluation_assignment_digest", "host_configuration_digest", "observed_at_ms"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "evaluation_trial"},
    "record_id": {"type": "string", "pattern": "^trial:[0-9a-f]{64}$"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "trial_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "cohort": {"enum": ["champion", "candidate"]},
    "task_slice": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "configuration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage": {"enum": ["end_to_end_complete", "root_turn_complete", "lifecycle_partial", "handshake_only", "partial", "conflicting", "unknown"]},
    "assigned": {"type": "boolean"},
    "status": {"enum": ["accepted", "rejected", "unverified", "failed", "cancelled", "interrupted"]},
    "accepted": {"type": "boolean"},
    "deterministic_pass": {"type": "boolean"},
    "security_pass": {"type": "boolean"},
    "required_criteria_pass": {"type": "boolean"},
    "quality_micros": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "terminal_failure": {"type": "boolean"},
    "repairs": {"type": "integer", "minimum": 0, "maximum": 10000},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "model_calls": {"type": ["integer", "null"], "minimum": 0},
    "client_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "client_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation_assignment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "host_configuration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_at_ms": {"type": "integer", "minimum": 0}
  }
}
