{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning evaluation assignment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "record_id", "candidate_digest", "task_slice", "case_ids", "case_digests", "case_set_digest", "client_version", "client_digest", "trial_plan", "observed_at_ms"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "evaluation_assignment"},
    "record_id": {"type": "string", "pattern": "^evaluation_assignment:[0-9a-f]{64}$"},
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_slice": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "case_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"}},
    "case_digests": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "case_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "client_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "client_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trial_plan": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trial_id", "case_id", "cohort", "configuration_digest"],
        "properties": {
          "trial_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
          "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
          "cohort": {"enum": ["champion", "candidate"]},
          "configuration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "observed_at_ms": {"type": "integer", "minimum": 0}
  }
}
