{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "run_id",
    "assignment_id",
    "task_slice",
    "fixture_digest",
    "model",
    "effort",
    "role",
    "topology",
    "max_parallel",
    "verification_required",
    "verifier_digest",
    "bounds_digest",
    "package_digest",
    "policy_digest",
    "agent_digest",
    "skill_digests",
    "prompt_digest",
    "client_digest",
    "configuration_digest",
    "observed_at_ms",
    "status",
    "deterministic_pass",
    "security_pass",
    "required_criteria_total",
    "required_criteria_passed",
    "quality_micros",
    "repairs",
    "repair_reason_codes",
    "delegation_overhead_tokens",
    "no_progress_events",
    "terminal_failure",
    "verifier_disagreement",
    "accepted",
    "coverage",
    "evaluation_candidate_digest",
    "evaluation_case_digest",
    "evidence_digests",
    "usage"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "outcome"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "task_slice": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "fixture_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "enum": [
        "gpt-5.6-luna",
        "gpt-5.6-terra",
        "gpt-5.6-sol",
        "gpt-6-luna",
        "gpt-6-sol",
        "gpt-6-astra"
      ]
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ]
    },
    "role": {
      "enum": [
        "codex_agents_researcher",
        "codex_agents_planner",
        "codex_agents_implementation_worker",
        "codex_agents_security_reviewer",
        "codex_agents_verification_worker"
      ]
    },
    "topology": {
      "enum": [
        "single",
        "delegated",
        "parallel"
      ]
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "verification_required": {
      "type": "boolean"
    },
    "verifier_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "bounds_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "agent_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "skill_digests": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "prompt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "accepted",
        "rejected",
        "unverified",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "execution_state": {
      "enum": ["completed", "failed", "timed_out", "interrupted", "cancelled", "invalid"]
    },
    "semantic_verdict": {
      "enum": ["pass", "ready", "ready-with-corrections", "not-ready", "blocked", "reject", "not-applicable"]
    },
    "admission_state": {
      "enum": ["unverified", "accepted", "rejected", "pending"]
    },
    "retry_attempt": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "retry_of_assignment_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "deterministic_pass": {
      "type": "boolean"
    },
    "security_pass": {
      "type": "boolean"
    },
    "required_criteria_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "required_criteria_passed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "quality_micros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "repairs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "repair_reason_codes": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "enum": [
          "assignment_mismatch",
          "duplicate_criterion",
          "failed_completed_evidence",
          "invalid_evidence",
          "invalid_shape",
          "invalid_status",
          "invalid_usage",
          "missing_evidence",
          "missing_required_evidence",
          "missing_required_fields",
          "unknown_criterion",
          "unknown_fields"
        ]
      }
    },
    "delegation_overhead_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "no_progress_events": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "terminal_failure": {
      "type": "boolean"
    },
    "verifier_disagreement": {
      "type": "boolean"
    },
    "accepted": {
      "type": "boolean"
    },
    "coverage": {
      "enum": [
        "end_to_end_complete",
        "root_turn_complete",
        "lifecycle_partial",
        "handshake_only",
        "partial",
        "conflicting",
        "unknown"
      ]
    },
    "evaluation_candidate_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluation_case_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_tokens",
        "output_tokens",
        "reasoning_tokens",
        "model_calls",
        "tool_calls",
        "latency_ms",
        "cost_microunits"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tool_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_microunits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "usage_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_tokens", "output_tokens", "reasoning_tokens", "model_calls", "tool_calls", "latency_ms", "cost_microunits"],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/usageSource"},
        "cached_tokens": {"$ref": "#/$defs/usageSource"},
        "output_tokens": {"$ref": "#/$defs/usageSource"},
        "reasoning_tokens": {"$ref": "#/$defs/usageSource"},
        "model_calls": {"$ref": "#/$defs/usageSource"},
        "tool_calls": {"$ref": "#/$defs/usageSource"},
        "latency_ms": {"$ref": "#/$defs/usageSource"},
        "cost_microunits": {"$ref": "#/$defs/usageSource"}
      }
    }
  },
  "$defs": {
    "usageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "coverage"],
      "properties": {
        "source": {"enum": ["host_observed", "client_observed", "unavailable"]},
        "coverage": {"enum": ["end_to_end_complete", "root_turn_complete", "lifecycle_partial", "handshake_only", "partial", "conflicting", "unknown"]}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "repairs": {"const": 0},
        "repair_reason_codes": {"maxItems": 0}
      }
    },
    {
      "properties": {
        "repairs": {"const": 1},
        "repair_reason_codes": {"minItems": 1, "maxItems": 1}
      }
    }
  ]
}
